# Copy to .env and fill in. The .env file is git-ignored.

# Required: the user id you were given for the test application.
QA_USER_ID=

# Optional overrides (defaults shown).
# QA_BASE_URL=https://qae-assignment-tau.vercel.app
# QA_HEADLESS=1
# QA_UI_TIMEOUT=10
# QA_BET_TIMEOUT=20
# QA_API_TIMEOUT=15

# Only needed when Chrome / chromedriver are not discoverable automatically.
# QA_CHROME_BINARY=/path/to/chrome
# QA_CHROMEDRIVER=/path/to/chromedriver
